# Copy to .env and fill in values. .env is gitignored: never commit real credentials.
# Empty values fall back to the built-in defaults.

# ── Application ──────────────────────────────────────────────────────────────
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
# Clients send this in the X-API-Key header for /api/v1/*. Required outside development.
API_KEY=
COMPETITORS_FILE=config/competitors.yaml

# ── LLM: Google Gemini (the project's only LLM provider) ─────────────────────
# NOT needed for Phase 1: website monitoring is deterministic and makes no LLM calls.
# Required from Phase 3 (competitor analysis) onward. Create a key in Google AI Studio;
# use a billing-enabled (paid tier) key in production.
GEMINI_API_KEY=
# Leave empty to use the default model (gemini-3.8-flash).
GEMINI_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# ── Crawler (Phase 1) ────────────────────────────────────────────────────────
# Identify the bot honestly and include a URL or email where site owners can reach you.
# Leave empty for the default: CompetitorMonitorBot/0.1 (+<this repository's URL>)
CRAWLER_USER_AGENT=
# Minimum seconds between requests to the same host (robots.txt Crawl-delay can raise it).
CRAWLER_MIN_DELAY_SECONDS=3
CRAWLER_DEFAULT_SCAN_LIMIT=25
