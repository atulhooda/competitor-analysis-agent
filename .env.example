# Copy to .env and fill in values. .env is gitignored: never commit real credentials.
# Empty values fall back to the built-in defaults.

# ── Application ──────────────────────────────────────────────────────────────
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
# Clients send this in the X-API-Key header for /api/v1/*. Required outside development.
API_KEY=
# YAML file imported with `python -m app competitors import` (the database is the source of truth).
COMPETITORS_FILE=config/competitors.yaml

# ── Database (Phase 2) ───────────────────────────────────────────────────────
# Leave empty for the local docker-compose database (passwordless, 127.0.0.1:5433).
# Production example: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# Keep the raw HTML of every captured content version (gzip-compressed).
STORE_RAW_HTML=true

# ── LLM: Google Gemini (the project's only LLM provider) ─────────────────────
# Not needed for scanning (Phases 1-2): monitoring is deterministic and makes no LLM calls.
# Required for AI analysis (Phase 3). Create a key in Google AI Studio; use a
# billing-enabled (paid tier) key in production.
GEMINI_API_KEY=
# Leave empty to use the default model (gemini-3.8-flash).
GEMINI_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
# Per-route models (empty → GEMINI_MODEL): bulk per-page analysis, and synthesis
# (competitor profiles, landscape briefings, change summaries, topic consolidation).
GEMINI_ANALYSIS_MODEL=
GEMINI_SYNTHESIS_MODEL=
# The image model, used only for blog cover images (PUBLISH_COVER_IMAGES) and never for
# text. Also available: gemini-3-pro-image, gemini-2.5-flash-image.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# How hard the model thinks per route: minimal | low | medium | high
ANALYSIS_REASONING_EFFORT=low
SYNTHESIS_REASONING_EFFORT=medium
# Cost controls, in tokens as reported by Gemini. No call is made past a budget.
LLM_MAX_TOKENS_PER_RUN=400000
# Tokens per UTC day across all runs. Empty → 2000000; 0 → unlimited.
LLM_DAILY_TOKEN_BUDGET=

# ── AI analysis (Phase 3) ────────────────────────────────────────────────────
# Optional seed taxonomy, imported with `python -m app topics import`.
TOPICS_FILE=config/topics.yaml
# Pages analyzed per run; the rest stay pending for the next run.
ANALYSIS_MAX_ITEMS_PER_RUN=40
# Pages per Gemini call, and the character budgets per call and per page (pages longer
# than the per-page budget are condensed extractively: opening, then section leads).
ANALYSIS_BATCH_SIZE=6
ANALYSIS_BATCH_MAX_CHARS=40000
ANALYSIS_ITEM_MAX_CHARS=6000
# Pages with fewer words, or flagged thin (likely JavaScript-rendered), aren't analyzed.
ANALYSIS_MIN_WORDS=80
# Lower floor for homepage, pricing, product and landing pages (plan names and prices
# say a lot in few words).
ANALYSIS_MIN_WORDS_POSITIONING=20
# Page types never analyzed, as a JSON list. Default: ["careers","legal","listing"]
# ANALYSIS_EXCLUDE_TYPES=["careers","legal","listing"]
ANALYSIS_MAX_CHANGE_SUMMARIES_PER_RUN=10
# How many existing topics to show the analyzer so it reuses their names.
ANALYSIS_TAXONOMY_PROMPT_LIMIT=150

# ── Crawler (Phase 1) ────────────────────────────────────────────────────────
# Identify the bot honestly and include a URL or email where site owners can reach you.
# Leave empty for the default: CompetitorMonitorBot/0.1 (+<this repository's URL>)
CRAWLER_USER_AGENT=
# Minimum seconds between requests to the same host (robots.txt Crawl-delay can raise it).
CRAWLER_MIN_DELAY_SECONDS=3
# Max new or changed pages fetched per scan (homepage and tracked pages are always fetched).
CRAWLER_DEFAULT_SCAN_LIMIT=25
# Captured pages are re-fetched only when a feed/sitemap reports a newer date, plus this many
# stale pages (not fetched for CRAWLER_REVISIT_AFTER_DAYS) per scan.
CRAWLER_REVISIT_LIMIT=5
CRAWLER_REVISIT_AFTER_DAYS=7

# ── Opportunities (Phase 4) ──────────────────────────────────────────────────
# Your company profile (imported with `python -m app company import`). Not a secret, but
# gitignored so your positioning stays out of the repository.
COMPANY_FILE=config/company.yaml
# Optional scoring configuration; built-in defaults apply without it.
SCORING_FILE=config/scoring.yaml

# ── Editorial topics: article ideas from your company profile alone ──────────
# `python -m app editorial propose` (or the pipeline's editorial stage) asks Gemini for
# article ideas on your core and adjacent topics, without competitor content. Scores
# (strategic fit), exclusions and duplicate checks are deterministic; each kept idea becomes
# an opportunity with the usual approval, article, quality and publishing path. Ideas kept
# per proposal run (Gemini is asked for about a third more):
EDITORIAL_TOPICS_PER_RUN=10

# ── Articles (Phase 5: drafts only; nothing is ever published) ───────────────
# Model for research, outline, draft and editing (empty → GEMINI_MODEL). Research uses
# Gemini's Google Search grounding and URL context tools.
GEMINI_WRITING_MODEL=
WRITING_REASONING_EFFORT=medium
RESEARCH_REASONING_EFFORT=low
# Token budget per article, across every step and every resume. Generation stops safely
# (keeping finished steps) when it runs out; raise it and `articles resume` to continue.
ARTICLE_MAX_TOKENS=400000
# Length the writer aims for, and the minimum a finished article must reach.
ARTICLE_TARGET_WORDS=1500
ARTICLE_MIN_WORDS=600
# Research material (facts, sources, competitor context) included in writing prompts.
ARTICLE_MAX_CONTEXT_CHARS=40000
# Research limits: research questions (Google Search queries requested), sources kept,
# page-reading calls (URL context; empty → 2), research tokens, and the minimum number of
# retrieved sources needed to continue (0 allows an article without external sources).
ARTICLE_RESEARCH_MAX_QUERIES=6
ARTICLE_RESEARCH_MAX_SOURCES=10
ARTICLE_RESEARCH_MAX_URL_CONTEXT_CALLS=
ARTICLE_RESEARCH_MAX_TOKENS=150000
ARTICLE_RESEARCH_MIN_SOURCES=2

# ── Quality (Phase 6: validates and prepares articles; nothing is published) ──
# Model for fact-checking, SEO and the quality judge (empty → GEMINI_MODEL). Revisions use
# GEMINI_WRITING_MODEL.
GEMINI_QUALITY_MODEL=
QUALITY_REASONING_EFFORT=low
# Phase 6 tokens per article (every validation and revision), within ARTICLE_MAX_TOKENS.
QUALITY_MAX_TOKENS=300000
# MAX_REVISIONS: automatic revisions made from one edited version, counting earlier
# validations' (0 = validate only; `articles revise` adds one more on request).
QUALITY_MAX_REVISIONS=2
# Mandatory gates: below the score, or above any limit, an article is never "ready".
QUALITY_MIN_SCORE=70
QUALITY_MAX_CONTRADICTED=0
QUALITY_MAX_UNSUPPORTED_RATIO=0.1
QUALITY_MAX_UNCITED_CLAIMS=3
# Score weights (points, rescaled to 100), as JSON. Default:
# QUALITY_WEIGHTS={"fact_support":20,"citation_coverage":20,"originality":20,"structure":10,"readability":10,"seo":10,"gemini_judgment":10}
# Fact-checking: claims per Gemini call; sources re-read with URL context per version when
# the stored research doesn't settle a claim; uncited sentences checked per version.
FACT_CHECK_BATCH_SIZE=8
FACT_CHECK_MAX_REREADS=4
FACT_CHECK_MAX_UNCITED_CANDIDATES=30
# Originality (deterministic word n-gram overlap with stored competitor and company pages):
# n-gram size; a passage is flagged at this similarity; at this similarity the overlap is
# severe (the article can't be "ready"); n-grams in this many stored pages are common phrasing;
# passages shorter than this are skipped.
ORIGINALITY_NGRAM_SIZE=8
ORIGINALITY_FLAG_THRESHOLD=0.25
ORIGINALITY_MAX_OVERLAP=0.5
ORIGINALITY_COMMON_DOC_FREQUENCY=3
ORIGINALITY_MIN_PASSAGE_WORDS=12
# SEO checks: meta title and description lengths, and the keyword density above which
# repetition counts as stuffing.
SEO_TITLE_MAX_CHARS=60
SEO_DESCRIPTION_MIN_CHARS=70
SEO_DESCRIPTION_MAX_CHARS=160
SEO_MAX_KEYWORD_DENSITY=0.03

# ── Publishing (Phases 7-8: only approved, ready article versions) ──
# Where approved articles go. github (default): the website's own repository, as a branch,
# an MDX file and a pull request; merging publishes it. wordpress: the earlier adapter,
# kept only until it is removed; never used unless set here.
CMS_PROVIDER=github
# Seconds per request to the target, and retries for transient failures (timeouts, 429,
# 5xx) of reads only. A change is never retried blindly: it is looked up first.
CMS_REQUEST_TIMEOUT=30
CMS_MAX_RETRIES=2
# The public website the articles appear on (live-URL verification, internal links),
# e.g. https://www.engageoagency.com
PUBLISH_SITE_URL=
# The site's GitHub repository (owner/name) and a fine-grained personal access token for
# that one repository with Contents and Pull requests set to read/write. Never commit it.
GITHUB_REPO=siddharthpathania/engageo-website
GITHUB_TOKEN=
GITHUB_BASE_BRANCH=main
# One <slug>.mdx per post, and the branch each post is proposed on: blog/<slug>.
GITHUB_CONTENT_DIR=src/content/blog
GITHUB_BRANCH_PREFIX=blog/
# The API host (default https://api.github.com; only GitHub Enterprise needs another).
GITHUB_API_URL=
# How long to wait for Vercel's preview or production deployment, and how often to look.
GITHUB_DEPLOY_TIMEOUT_SECONDS=900
GITHUB_DEPLOY_POLL_SECONDS=15
# If Vercel Authentication protects preview deployments: the project's "Protection Bypass
# for Automation" secret (Vercel → Settings → Deployment Protection). Sent only to
# *.vercel.app preview hosts, never to the site or GitHub, never logged. Never commit it.
VERCEL_PROTECTION_BYPASS_SECRET=
# The byline of agent-written posts (fixed configuration, never model output), the one
# call-to-action block every post ends with, and the closing italic byline paragraph.
PUBLISH_AUTHOR_NAME=Engageo Team
PUBLISH_AUTHOR_ROLE=AI Content
PUBLISH_AUTHOR_INITIALS=EN
PUBLISH_AUTHOR_LINKEDIN=
PUBLISH_CTA_TITLE=See Engageo in action
PUBLISH_CTA_BODY=15 minutes, no deck. See how Engageo answers every missed call, follows up on WhatsApp and books the patient into your calendar.
PUBLISH_CTA_LABEL=Book a demo
PUBLISH_CTA_HREF=/contact?intent=demo
PUBLISH_BYLINE=The Engageo Team builds AI missed-call recovery and WhatsApp automation for Indian clinics and hospitals. This article was researched and written with AI assistance and checked against its sources before publication.
# ── Cover images (off by default) ──
# true: each published post gets one cover picture, committed to the site's repository on
# the post's own branch and named in its frontmatter (coverImage, with coverWidth/
# coverHeight). One picture per article version, obtained once and reused by every retry;
# a picture that can't be had is a warning, never a failed publication.
PUBLISH_COVER_IMAGES=false
# Where that picture comes from:
#   gemini (default) — an illustration drawn by GEMINI_IMAGE_MODEL. The prompt forbids
#                      text, logos, identifiable people and anything clinical.
#   pexels           — a Pexels stock photo, chosen by fixed rules from the article's
#                      keyword, audience and format: no model call, landscape, closest to
#                      16:9, and never a photo an earlier post already used.
COVER_IMAGE_SOURCE=gemini
# Only for COVER_IMAGE_SOURCE=pexels: a free API key from https://www.pexels.com/api/.
# Sent to api.pexels.com only (the picture itself is fetched from images.pexels.com with
# no credential). Empty with pexels selected: covers are skipped with a warning.
PEXELS_API_KEY=
# Where the picture is committed in the site's repository, and the path the frontmatter
# points at (the site serves public/ at the root; empty → /blog/covers).
COVER_IMAGE_DIR=public/blog/covers
COVER_IMAGE_URL_PREFIX=
# ── WordPress (the earlier adapter; only with CMS_PROVIDER=wordpress) ──
# Your WordPress site (https; http only for localhost) and a user with an Application Password
# (Users → Profile → Application Passwords). Never your normal password. Never commit these.
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
# Where publishing leaves a post: draft (default; GitHub: an open pull request with a
# verified preview), pending (WordPress "Pending Review"; a draft elsewhere) or publish.
PUBLISH_DEFAULT_STATUS=draft
# Optional: the post author (user ID), and the category (ID) used when the SEO package has none.
WORDPRESS_DEFAULT_AUTHOR_ID=
WORDPRESS_DEFAULT_CATEGORY_ID=
# Making a post public (GitHub: merging the pull request into the base branch) needs this.
# Fully automatic publication needs this, PUBLISH_AUTO_APPROVE=true and
# AUTOMATED_PUBLISHING_ENABLED=true.
PUBLISH_ALLOW_DIRECT_PUBLISH=false
# Create categories and tags that don't exist in WordPress (otherwise a missing category
# blocks publishing and missing tags are left out).
WORDPRESS_CREATE_MISSING_TERMS=false
# Approve ready articles automatically when publishing (never overrides a rejection).
PUBLISH_AUTO_APPROVE=false
# Going public: create and verify a draft first, then publish it.
PUBLISH_DRAFT_FIRST=true

# ── Scheduling and the autonomous pipeline (Phase 8; everything off by default) ──
# Phase 8 introduces autonomous scheduling and pipeline orchestration. Social media automation
# is intentionally deferred to Phase 9.
# The worker (`uv run python -m app worker`) fires schedules only when this is true. Manual
# runs (`schedule run`, `pipeline run`, POST /api/v1/pipeline/run) work either way.
SCHEDULER_ENABLED=false
# Schedules and daily limits use this timezone's calendar (IANA name; DST-aware). Times are
# stored in UTC.
SCHEDULER_TIMEZONE=Asia/Kolkata
# Cron schedules: "minute hour day month weekday" or @hourly, @daily, @weekly. Empty: not
# scheduled. E.g. FULL_PIPELINE_SCHEDULE=0 6 * * * (every day at 06:00). Usually either the
# full pipeline or the separate stages, not both.
FULL_PIPELINE_SCHEDULE=
SCAN_SCHEDULE=
ANALYSIS_SCHEDULE=
OPPORTUNITY_SCHEDULE=
EDITORIAL_SCHEDULE=
ARTICLE_GENERATION_SCHEDULE=
QUALITY_SCHEDULE=
PUBLISH_SCHEDULE=
# After an outage, one catch-up run per schedule for the latest occurrence missed within
# this many hours (0: none). Missed runs are never replayed one by one.
SCHEDULER_CATCH_UP_HOURS=24
# How often the worker looks for queued jobs (retries, API runs) and dead ones.
SCHEDULER_POLL_SECONDS=30
# The kill switch for automated publishing, separate from the scheduler: false keeps the
# pipeline away from the CMS entirely (no draft, no post). Publishing still goes through
# Phase 7 (approval, quality gate, PUBLISH_ALLOW_DIRECT_PUBLISH, PUBLISH_DRAFT_FIRST).
AUTOMATED_PUBLISHING_ENABLED=false
# Articles created per day, one allowance per opportunity origin (checked before any is
# written; the best opportunities first): from competitor opportunities, and from editorial
# topics (the pipeline's editorial stage proposes just enough ideas to fill it). Then
# successful public publications per day (drafts and failed attempts don't count; enforced
# atomically). 0 means none, never unlimited: editorial topics are off by default.
MAX_ARTICLES_GENERATED_PER_DAY=3
MAX_EDITORIAL_ARTICLES_PER_DAY=0
MAX_ARTICLES_PER_DAY=1
# Jobs that can spend Gemini tokens running at the same time (a second job of the same type
# is always skipped).
MAX_CONCURRENT_PIPELINES=1
# A running job with no heartbeat for this long, whose process is gone, is continued from its
# last checkpoint.
JOB_STALE_AFTER_MINUTES=60
# Transient failures (network, Gemini unavailable, WordPress 429/5xx) are retried with
# exponential backoff: base, 2x base, 4x base… up to the maximum, JOB_MAX_ATTEMPTS attempts
# in all. Configuration, credential and quality-gate failures are never retried.
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=300
JOB_RETRY_MAX_SECONDS=3600
# Let the pipeline approve the new or reviewed opportunities it selects (at least this score)
# so it can write them. false: only opportunities a person approved are written. Articles
# still need an approval (a person's, or PUBLISH_AUTO_APPROVE) to be published.
PIPELINE_APPROVE_OPPORTUNITIES=true
PIPELINE_MIN_OPPORTUNITY_SCORE=60
