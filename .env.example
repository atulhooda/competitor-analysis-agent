# Copy to .env and fill in values. .env is gitignored: never commit real credentials.
# Empty values fall back to the built-in defaults.

# ── Application ──────────────────────────────────────────────────────────────
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
# Clients send this in the X-API-Key header for /api/v1/*. Required outside development.
API_KEY=
# YAML file imported with `python -m app competitors import` (the database is the source of truth).
COMPETITORS_FILE=config/competitors.yaml

# ── Database (Phase 2) ───────────────────────────────────────────────────────
# Leave empty for the local docker-compose database (passwordless, 127.0.0.1:5433).
# Production example: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# Keep the raw HTML of every captured content version (gzip-compressed).
STORE_RAW_HTML=true

# ── LLM: Google Gemini (the project's only LLM provider) ─────────────────────
# Not needed for scanning (Phases 1-2): monitoring is deterministic and makes no LLM calls.
# Required for AI analysis (Phase 3). Create a key in Google AI Studio; use a
# billing-enabled (paid tier) key in production.
GEMINI_API_KEY=
# Leave empty to use the default model (gemini-3.8-flash).
GEMINI_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
# Per-route models (empty → GEMINI_MODEL): bulk per-page analysis, and synthesis
# (competitor profiles, landscape briefings, change summaries, topic consolidation).
GEMINI_ANALYSIS_MODEL=
GEMINI_SYNTHESIS_MODEL=
# How hard the model thinks per route: minimal | low | medium | high
ANALYSIS_REASONING_EFFORT=low
SYNTHESIS_REASONING_EFFORT=medium
# Cost controls, in tokens as reported by Gemini. No call is made past a budget.
LLM_MAX_TOKENS_PER_RUN=400000
# Tokens per UTC day across all runs. Empty → 2000000; 0 → unlimited.
LLM_DAILY_TOKEN_BUDGET=

# ── AI analysis (Phase 3) ────────────────────────────────────────────────────
# Optional seed taxonomy, imported with `python -m app topics import`.
TOPICS_FILE=config/topics.yaml
# Pages analyzed per run; the rest stay pending for the next run.
ANALYSIS_MAX_ITEMS_PER_RUN=40
# Pages per Gemini call, and the character budgets per call and per page (pages longer
# than the per-page budget are condensed extractively: opening, then section leads).
ANALYSIS_BATCH_SIZE=6
ANALYSIS_BATCH_MAX_CHARS=40000
ANALYSIS_ITEM_MAX_CHARS=6000
# Pages with fewer words, or flagged thin (likely JavaScript-rendered), aren't analyzed.
ANALYSIS_MIN_WORDS=80
# Lower floor for homepage, pricing, product and landing pages (plan names and prices
# say a lot in few words).
ANALYSIS_MIN_WORDS_POSITIONING=20
# Page types never analyzed, as a JSON list. Default: ["careers","legal","listing"]
# ANALYSIS_EXCLUDE_TYPES=["careers","legal","listing"]
ANALYSIS_MAX_CHANGE_SUMMARIES_PER_RUN=10
# How many existing topics to show the analyzer so it reuses their names.
ANALYSIS_TAXONOMY_PROMPT_LIMIT=150

# ── Crawler (Phase 1) ────────────────────────────────────────────────────────
# Identify the bot honestly and include a URL or email where site owners can reach you.
# Leave empty for the default: CompetitorMonitorBot/0.1 (+<this repository's URL>)
CRAWLER_USER_AGENT=
# Minimum seconds between requests to the same host (robots.txt Crawl-delay can raise it).
CRAWLER_MIN_DELAY_SECONDS=3
# Max new or changed pages fetched per scan (homepage and tracked pages are always fetched).
CRAWLER_DEFAULT_SCAN_LIMIT=25
# Captured pages are re-fetched only when a feed/sitemap reports a newer date, plus this many
# stale pages (not fetched for CRAWLER_REVISIT_AFTER_DAYS) per scan.
CRAWLER_REVISIT_LIMIT=5
CRAWLER_REVISIT_AFTER_DAYS=7

# ── Opportunities (Phase 4) ──────────────────────────────────────────────────
# Your company profile (imported with `python -m app company import`). Not a secret, but
# gitignored so your positioning stays out of the repository.
COMPANY_FILE=config/company.yaml
# Optional scoring configuration; built-in defaults apply without it.
SCORING_FILE=config/scoring.yaml

# ── Articles (Phase 5: drafts only; nothing is ever published) ───────────────
# Model for research, outline, draft and editing (empty → GEMINI_MODEL). Research uses
# Gemini's Google Search grounding and URL context tools.
GEMINI_WRITING_MODEL=
WRITING_REASONING_EFFORT=medium
RESEARCH_REASONING_EFFORT=low
# Token budget per article, across every step and every resume. Generation stops safely
# (keeping finished steps) when it runs out; raise it and `articles resume` to continue.
ARTICLE_MAX_TOKENS=400000
# Length the writer aims for, and the minimum a finished article must reach.
ARTICLE_TARGET_WORDS=1500
ARTICLE_MIN_WORDS=600
# Research material (facts, sources, competitor context) included in writing prompts.
ARTICLE_MAX_CONTEXT_CHARS=40000
# Research limits: research questions (Google Search queries requested), sources kept,
# page-reading calls (URL context; empty → 2), research tokens, and the minimum number of
# retrieved sources needed to continue (0 allows an article without external sources).
ARTICLE_RESEARCH_MAX_QUERIES=6
ARTICLE_RESEARCH_MAX_SOURCES=10
ARTICLE_RESEARCH_MAX_URL_CONTEXT_CALLS=
ARTICLE_RESEARCH_MAX_TOKENS=150000
ARTICLE_RESEARCH_MIN_SOURCES=2

# ── Quality (Phase 6: validates and prepares articles; nothing is published) ──
# Model for fact-checking, SEO and the quality judge (empty → GEMINI_MODEL). Revisions use
# GEMINI_WRITING_MODEL.
GEMINI_QUALITY_MODEL=
QUALITY_REASONING_EFFORT=low
# Phase 6 tokens per article (every validation and revision), within ARTICLE_MAX_TOKENS.
QUALITY_MAX_TOKENS=300000
# MAX_REVISIONS: automatic revisions made from one edited version, counting earlier
# validations' (0 = validate only; `articles revise` adds one more on request).
QUALITY_MAX_REVISIONS=2
# Mandatory gates: below the score, or above any limit, an article is never "ready".
QUALITY_MIN_SCORE=70
QUALITY_MAX_CONTRADICTED=0
QUALITY_MAX_UNSUPPORTED_RATIO=0.1
QUALITY_MAX_UNCITED_CLAIMS=3
# Score weights (points, rescaled to 100), as JSON. Default:
# QUALITY_WEIGHTS={"fact_support":20,"citation_coverage":20,"originality":20,"structure":10,"readability":10,"seo":10,"gemini_judgment":10}
# Fact-checking: claims per Gemini call; sources re-read with URL context per version when
# the stored research doesn't settle a claim; uncited sentences checked per version.
FACT_CHECK_BATCH_SIZE=8
FACT_CHECK_MAX_REREADS=4
FACT_CHECK_MAX_UNCITED_CANDIDATES=30
# Originality (deterministic word n-gram overlap with stored competitor and company pages):
# n-gram size; a passage is flagged at this similarity; at this similarity the overlap is
# severe (the article can't be "ready"); n-grams in this many stored pages are common phrasing;
# passages shorter than this are skipped.
ORIGINALITY_NGRAM_SIZE=8
ORIGINALITY_FLAG_THRESHOLD=0.25
ORIGINALITY_MAX_OVERLAP=0.5
ORIGINALITY_COMMON_DOC_FREQUENCY=3
ORIGINALITY_MIN_PASSAGE_WORDS=12
# SEO checks: meta title and description lengths, and the keyword density above which
# repetition counts as stuffing.
SEO_TITLE_MAX_CHARS=60
SEO_DESCRIPTION_MIN_CHARS=70
SEO_DESCRIPTION_MAX_CHARS=160
SEO_MAX_KEYWORD_DENSITY=0.03

# ── Publishing (Phase 7: only approved, ready article versions; WordPress drafts by default) ──
# The CMS publishing goes to (only WordPress so far).
CMS_PROVIDER=wordpress
# Seconds per CMS request, and retries for transient failures (timeouts, 429, 5xx) only.
# A post creation is never retried blindly: the post is looked up first.
CMS_REQUEST_TIMEOUT=30
CMS_MAX_RETRIES=2
# Your WordPress site (https; http only for localhost) and a user with an Application Password
# (Users → Profile → Application Passwords). Never your normal password. Never commit these.
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
# Post status publishing leaves: draft (default), pending (review in WordPress) or publish.
WORDPRESS_DEFAULT_STATUS=draft
# Optional: the post author (user ID), and the category (ID) used when the SEO package has none.
WORDPRESS_DEFAULT_AUTHOR_ID=
WORDPRESS_DEFAULT_CATEGORY_ID=
# Making a post public needs this. Fully automatic publication needs both this and
# PUBLISH_AUTO_APPROVE=true.
WORDPRESS_ALLOW_DIRECT_PUBLISH=false
# Create categories and tags that don't exist in WordPress (otherwise a missing category
# blocks publishing and missing tags are left out).
WORDPRESS_CREATE_MISSING_TERMS=false
# Approve ready articles automatically when publishing (never overrides a rejection).
PUBLISH_AUTO_APPROVE=false
# Going public: create and verify a draft first, then publish it.
PUBLISH_DRAFT_FIRST=true
